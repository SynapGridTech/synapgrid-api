# ==============================
# SynapGrid API — Environment
# ==============================

# Application
NODE_ENV=development
PORT=3000
APP_NAME=SynapGrid API
API_PREFIX=api
GLOBAL_PREFIX_VERSION=v1

# CORS — comma separated origins (* for all, dev only)
CORS_ORIGINS=*

# Database — sqlite (default) or postgres
DB_TYPE=sqlite
DB_DATABASE=./data/synapgrid.sqlite

# Postgres (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SYNCHRONIZE=false
DB_SSL=false

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin bootstrap (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@synapgrid.net
SEED_ADMIN_PASSWORD=Admin@123!

# Rate limiting (global throttle)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Mailer — set MAIL_ENABLED=false for console-only logging in development
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SynapGrid <no-reply@synapgrid.net>"
